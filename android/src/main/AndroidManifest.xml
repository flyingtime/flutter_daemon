<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 前台 Service（API 29+ 需声明 FOREGROUND_SERVICE 才能调用 startForeground） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 13+ 前台 Service 通知需 POST_NOTIFICATIONS 才能展示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自启：接收系统 BOOT_COMPLETED 广播。仅当 Dart 侧显式调用
         enableBootAutoStart() 开启开关后，接收器才会实际拉起应用。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!--
          保活 Service，跑在 :daemon 独立进程，由 native daemon 进程通过
          `am startservice -n <pkg>/com.flutter_daemon.flutter_daemon.service.DaemonService` 拉起。
          宿主无需手动声明，manifest merger 会自动合并。
        -->
        <service
            android:name="com.flutter_daemon.flutter_daemon.service.DaemonService"
            android:process=":daemon"
            android:exported="false" />

        <!--
          保活广播接收器,跑在 :daemon 独立进程,由 native daemon 进程通过
          `am broadcast -a <pkg>.DaemonService.CHECK -n <pkg>/...DaemonReceiver` 周期触发。
          部分 Android 7.x ROM 对已运行 Service 重复 startservice 不派发 onStartCommand,
          broadcast 通路与其互为备份。
        -->
        <receiver
            android:name="com.flutter_daemon.flutter_daemon.receiver.DaemonReceiver"
            android:process=":daemon"
            android:exported="false" />

        <!--
          开机自启接收器,跑在主进程(需读取主进程 MethodChannel 侧写入的开关状态)。
          系统开机完成(BOOT_COMPLETED / QUICKBOOT_POWERON)时拉起,仅当 Dart 侧
          显式调用 enableBootAutoStart() 打开开关才实际启动 :daemon Service。
          BOOT_COMPLETED 是系统受保护广播,android:exported 无实际影响;API 31+
          要求显式声明 exported。
        -->
        <receiver
            android:name="com.flutter_daemon.flutter_daemon.receiver.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          覆盖安装(更新)后自启动接收器,跑在主进程。应用被覆盖安装时系统发送
          MY_PACKAGE_REPLACED 广播,收到后拉起 :daemon 保活 Service,由 Service
          检测主进程不在后拉起应用界面。无条件启动(不看任何开关)。
          MY_PACKAGE_REPLACED 是系统受保护广播,android:exported 无实际影响;
          API 31+ 要求显式声明 exported。
        -->
        <receiver
            android:name="com.flutter_daemon.flutter_daemon.receiver.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
